---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const travelStories = await getCollection('travel', ({ data }) => !data.draft);
  return travelStories.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'travel'> };
const heroSrc = entry.data.hero;
const formattedDate = new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric' }).format(
  entry.data.date
);
const { Content } = await entry.render();
---

<Base title={entry.data.title} description={entry.data.summary}>
  <Header />
  <main class="container" style="max-width:100ch;">
    <a href="/travel/">← Back to travel</a>
    <article style="margin-top:1.5rem;">
      <header style="display:flex;flex-direction:column;gap:0.75rem;">
        <p style="margin:0;color:var(--muted);">
          {entry.data.location} · {formattedDate}
        </p>
        <h1 style="margin:0;">{entry.data.title}</h1>
      </header>

      {heroSrc ? (
        <img
          src={heroSrc}
          alt={`Scene from ${entry.data.title}`}
          style="margin:1.5rem 0;border-radius:1rem;border:1px solid var(--border);"
          loading="lazy"
          width="800"
          height="450"
        />
      ) : null}

      <p style="font-size:1.1rem;color:var(--muted);">{entry.data.summary}</p>

      {entry.data.highlights.length ? (
        <section style="margin:2rem 0;">
          <h2>Highlights</h2>
          <ul>
            {entry.data.highlights.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </section>
      ) : null}

      <section>
        <h2>Itinerary Notes</h2>
        <div class="entry-content">
          <Content />
        </div>
      </section>
    </article>
  </main>
  <Footer />
</Base>
