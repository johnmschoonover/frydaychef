---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes', ({ data }) => !data.draft);
  const tagMap = new Map<string, CollectionEntry<'recipes'>[]>();
  recipes.forEach((recipe) => {
    recipe.data.tags.forEach((tag) => {
      const key = tag.toLowerCase();
      if (!tagMap.has(key)) {
        tagMap.set(key, []);
      }
      tagMap.get(key)?.push(recipe);
    });
  });

  return Array.from(tagMap.entries()).map(([tag, entries]) => ({
    params: { tag },
    props: { tag, entries }
  }));
}

const { tag, entries } = Astro.props as {
  tag: string;
  entries: CollectionEntry<'recipes'>[];
};
---

<Base title={`Tag: ${tag}`} description={`Recipes tagged ${tag} on Fryday Chef.`}>
  <Header />
  <main class="container">
    <a href="/tags/">← All tags</a>
    <h1 style="text-transform:capitalize;">#{tag}</h1>
    {entries.length ? (
      <div class="card-grid">
        {entries
          .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
          .map((recipe) => (
            <RecipeCard recipe={recipe} />
          ))}
      </div>
    ) : (
      <p>No recipes for this tag yet.</p>
    )}
  </main>
  <Footer />
</Base>
