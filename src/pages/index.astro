---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const recipes = (await getCollection('recipes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const restaurants = (await getCollection('restaurants', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const travelStories = (await getCollection('travel', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const kitchenNotes = (await getCollection('kitchen-notes')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
const latestRecipe = recipes[0];
const latestRestaurant = restaurants[0];
const latestTravel = travelStories[0];
const latestKitchenNote = kitchenNotes[0];
const paneCardCount = 4;
const featuredRecipe = recipes.find((entry) => Boolean(entry.data.hero)) ?? latestRecipe;
const heroHighlightSrc = featuredRecipe?.data.hero ?? '/images/grilled-cheese/hero-deluxe.webp';
const heroHighlightAlt = featuredRecipe
  ? `Featured recipe hero: ${featuredRecipe.data.title}`
  : 'Featured Fryday Chef recipe';
const getFallbackInitial = (entry?: { data: { title?: string } }) =>
  entry?.data.title?.slice(0, 1).toUpperCase() ?? 'F';
---

<Base title="Home">
  <Header />
  <main class="home">
    <section class="home-hero">
      <div class="container hero-grid">
        <div class="hero-content">
          <h1 class="hero-title">Southern-inspired dishes with a modern sway.</h1>
          <p class="hero-subtitle">
            Browse tried-and-true plates, destination dining notes, and travel stories celebrating relaxed gatherings and
            easy hospitality.
          </p>
          <div class="hero-actions">
            <a class="button button--primary" href="/recipes/">Explore recipes</a>
          </div>
        </div>
        <figure class="hero-visual">
          <div class="hero-visual__image">
            <img src={heroHighlightSrc} alt={heroHighlightAlt} loading="lazy" width="640" height="640" />
          </div>
          {featuredRecipe ? (
            <figcaption>
              <span class="hero-pill">Featured</span>
              <div>
                <p class="hero-eyebrow">Latest recipe</p>
                <p class="hero-highlight">{featuredRecipe.data.title}</p>
              </div>
            </figcaption>
          ) : null}
        </figure>
      </div>
    </section>

    <section class="container home-panels" aria-labelledby="explore-sections">
      <div class="section-heading">
        <span class="heading-ornament">Collections</span>
        <h2 id="explore-sections">Plan your next bite</h2>
      </div>
      <div class="pane-grid" data-count={paneCardCount}>
        <article class="pane-card">
          <span class="pane-card__eyebrow">Recipes</span>
          <div class="pane-card__header">
            <h3>From stovetop to table</h3>
            <a href="/recipes/">Browse all</a>
          </div>
          {latestRecipe ? (
            <a class="latest-card" href={`/recipes/${latestRecipe.slug}/`}>
              <div class="latest-media" aria-hidden={!latestRecipe.data.hero}>
                {latestRecipe.data.hero ? (
                  <img
                    src={latestRecipe.data.hero}
                    alt={`Preview for ${latestRecipe.data.title}`}
                    loading="lazy"
                    width="320"
                    height="320"
                  />
                ) : (
                  <div class="latest-placeholder">{getFallbackInitial(latestRecipe)}</div>
                )}
              </div>
              <div class="latest-card__body">
                <p>Latest recipe</p>
                <span class="latest-link">{latestRecipe.data.title}</span>
                <p>{latestRecipe.data.steps?.[0] ?? 'See the full recipe for details.'}</p>
              </div>
            </a>
          ) : (
            <p>New recipes coming soon.</p>
          )}
        </article>
        <article class="pane-card">
          <span class="pane-card__eyebrow">Restaurants</span>
          <div class="pane-card__header">
            <h3>Reservations worth planning</h3>
            <a href="/restaurants/">Guide</a>
          </div>
          {latestRestaurant ? (
            <a class="latest-card" href={`/restaurants/${latestRestaurant.slug}/`}>
              <div class="latest-media" aria-hidden={!latestRestaurant.data.hero}>
                {latestRestaurant.data.hero ? (
                  <img
                    src={latestRestaurant.data.hero}
                    alt={`Preview for ${latestRestaurant.data.title}`}
                    loading="lazy"
                    width="320"
                    height="320"
                  />
                ) : (
                  <div class="latest-placeholder">{getFallbackInitial(latestRestaurant)}</div>
                )}
              </div>
              <div class="latest-card__body">
                <p>Latest feature</p>
                <span class="latest-link">{latestRestaurant.data.title}</span>
                <p>{latestRestaurant.data.summary ?? 'Discover our latest restaurant pick.'}</p>
              </div>
            </a>
          ) : (
            <p>Restaurant spotlights arrive soon.</p>
          )}
        </article>
        <article class="pane-card">
          <span class="pane-card__eyebrow">Kitchen Notes</span>
          <div class="pane-card__header">
            <h3>Behind the scenes</h3>
            <a href="/kitchen-notes/">Browse notes</a>
          </div>
          {latestKitchenNote ? (
            <a
              class="latest-card"
              href={`/kitchen-notes/${latestKitchenNote.data.slug ?? latestKitchenNote.slug}/`}
            >
              <div class="latest-media" aria-hidden="true">
                <div class="latest-placeholder">✍️</div>
              </div>
              <div class="latest-card__body">
                <p>Latest note</p>
                <span class="latest-link">{latestKitchenNote.data.title}</span>
                <p>{latestKitchenNote.data.summary}</p>
              </div>
            </a>
          ) : (
            <p>Kitchen notes return soon.</p>
          )}
        </article>
        <article class="pane-card">
          <span class="pane-card__eyebrow">Travel</span>
          <div class="pane-card__header">
            <h3>Trips built around meals</h3>
            <a href="/travel/">City notes</a>
          </div>
          {latestTravel ? (
            <a class="latest-card" href={`/travel/${latestTravel.slug}/`}>
              <div class="latest-media" aria-hidden={!latestTravel.data.hero}>
                {latestTravel.data.hero ? (
                  <img
                    src={latestTravel.data.hero}
                    alt={`Preview for ${latestTravel.data.title}`}
                    loading="lazy"
                    width="320"
                    height="320"
                  />
                ) : (
                  <div class="latest-placeholder">{getFallbackInitial(latestTravel)}</div>
                )}
              </div>
              <div class="latest-card__body">
                <p>Latest story</p>
                <span class="latest-link">{latestTravel.data.title}</span>
                <p>{latestTravel.data.summary ?? 'Follow along on our newest food-focused getaway.'}</p>
              </div>
            </a>
          ) : (
            <p>Travel dispatches are in progress.</p>
          )}
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Base>
