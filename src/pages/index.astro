---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const recipes = (await getCollection('recipes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const restaurants = (await getCollection('restaurants', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const travelStories = (await getCollection('travel', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const latestRecipe = recipes[0];
const latestRestaurant = restaurants[0];
const latestTravel = travelStories[0];
---

<Base title="Home">
  <Header />
  <main class="home">
    <section class="home-hero">
      <div class="container hero-content">
        <h1 class="hero-title">Southern-inspired dishes with a modern sway.</h1>
        <p class="hero-subtitle">
          Browse tried-and-true plates, destination dining notes, and travel stories celebrating relaxed gatherings and
          easy hospitality.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="/recipes/">Explore recipes</a>
          <a class="button button--ghost" href="/about/">Our story</a>
        </div>
      </div>
    </section>

    <section class="container home-panels" aria-labelledby="explore-sections">
      <div class="section-heading">
        <span class="heading-ornament">Collections</span>
        <h2 id="explore-sections">Plan your next bite</h2>
      </div>
      <div class="pane-grid">
        <article class="pane-card">
          <span class="pane-card__eyebrow">Recipes</span>
          <div class="pane-card__header">
            <h3>From stovetop to table</h3>
            <a href="/recipes/">Browse all</a>
          </div>
          {latestRecipe ? (
            <a class="latest-card" href={`/recipes/${latestRecipe.slug}/`}>
              <p>Latest recipe</p>
              <span class="latest-link">{latestRecipe.data.title}</span>
              <p>{latestRecipe.data.steps?.[0] ?? 'See the full recipe for details.'}</p>
            </a>
          ) : (
            <p>New recipes coming soon.</p>
          )}
        </article>
        <article class="pane-card">
          <span class="pane-card__eyebrow">Restaurants</span>
          <div class="pane-card__header">
            <h3>Reservations worth planning</h3>
            <a href="/restaurants/">Guide</a>
          </div>
          {latestRestaurant ? (
            <a class="latest-card" href={`/restaurants/${latestRestaurant.slug}/`}>
              <p>Latest feature</p>
              <span class="latest-link">{latestRestaurant.data.title}</span>
              <p>{latestRestaurant.data.summary ?? 'Discover our latest restaurant pick.'}</p>
            </a>
          ) : (
            <p>Restaurant spotlights arrive soon.</p>
          )}
        </article>
        <article class="pane-card">
          <span class="pane-card__eyebrow">Travel</span>
          <div class="pane-card__header">
            <h3>Trips built around meals</h3>
            <a href="/travel/">City notes</a>
          </div>
          {latestTravel ? (
            <a class="latest-card" href={`/travel/${latestTravel.slug}/`}>
              <p>Latest story</p>
              <span class="latest-link">{latestTravel.data.title}</span>
              <p>{latestTravel.data.summary ?? 'Follow along on our newest food-focused getaway.'}</p>
            </a>
          ) : (
            <p>Travel dispatches are in progress.</p>
          )}
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Base>
