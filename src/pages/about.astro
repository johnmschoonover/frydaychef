---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="About" description="Meet Fryday Chef, a cozy-modern recipe journal.">
  <Header />
  <main class="container" style="max-width:60ch;">
    <h1>About Fryday Chef</h1>
    <p>
      Fryday Chef is a personal recipe journal focused on approachable techniques, bold flavors, and
      relaxed entertaining. Every post highlights clear ingredient lists, flexible timing notes, and
      flavor-packed twists to help you cook confidently on a Friday night—or any day you need a little
      kitchen inspiration.
    </p>
  </main>
  <Footer />
</Base>
