---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import KnifeRating from '../../components/KnifeRating.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const restaurants = await getCollection('restaurants', ({ data }) => !data.draft);
  return restaurants.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'restaurants'> };
const heroSrc = entry.data.hero;
const formattedDate = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(entry.data.date);
const { Content } = await entry.render();
---

<Base title={entry.data.title} description={entry.data.summary}>
  <Header />
  <main class="container restaurant-layout">
    <aside class="jump-nav">
      <nav aria-label="Visit sections">
        <ul>
          <li><a href="#visits"><span>Visits</span></a></li>
          <li><a href="#atmosphere"><span>Atmosphere & Service</span></a></li>
          <li><a href="#starters"><span>Starters & Sides</span></a></li>
          <li><a href="#steaks"><span>Steak & Mains</span></a></li>
          <li><a href="#sauces"><span>Sauces & Pairings</span></a></li>
          <li><a href="#price"><span>Price & Value</span></a></li>
          <li><a href="#verdict"><span>Verdict</span></a></li>
        </ul>
      </nav>
    </aside>
    <article class="restaurant-article">
      <header style="display:flex;flex-direction:column;gap:0.75rem;">
        <p style="margin:0;color:var(--muted);">
          {entry.data.location} · {entry.data.cuisine} · {formattedDate}
        </p>
        <h1 style="margin:0;">{entry.data.title}</h1>
        {typeof entry.data.rating === 'number' ? (
          <KnifeRating rating={entry.data.rating} symbol={entry.data.ratingSymbol} />
        ) : null}
      </header>

      {heroSrc ? (
        <img
          src={heroSrc}
          alt={`Scene from ${entry.data.title}`}
          style="margin:1.5rem 0;border-radius:1rem;border:1px solid var(--border);"
          loading="lazy"
          width="800"
          height="450"
        />
      ) : null}

      <p style="font-size:1.1rem;color:var(--muted);">{entry.data.summary}</p>

      {entry.data.mustTry.length ? (
        <section class="must-try-panel">
          <div class="must-try-header">
            <h2>Must-try bites</h2>
            <p class="must-try-hint">Tap a bite to spotlight where it shows up.</p>
          </div>
          <ul class="must-try-list" data-count={entry.data.mustTry.length}>
            {entry.data.mustTry.map((dish) => (
              <li>
                <button type="button" class="must-try-chip" data-dish={dish} aria-pressed="false">
                  <span>{dish}</span>
                </button>
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      <section>
        <h2>Visit notes</h2>
        <div class="entry-content">
          <Content />
        </div>
      </section>
    </article>
  </main>
  <Footer />
  <script is:inline>
    const normalizeText = (value) =>
      value
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();

    const getDishKey = (dish) => {
      const withoutParentheses = dish.replace(/\(.*?\)/g, ' ');
      return normalizeText(withoutParentheses);
    };

    const stopWords = new Set([
      'with',
      'and',
      'or',
      'the',
      'a',
      'an',
      'plus',
      'amp',
      'of',
      'for',
      'on',
      'in',
      'served',
      'sauce',
      'sauces',
      'sided',
      'combo'
    ]);

    const initMustTryHighlighter = () => {
      const panel = document.querySelector('.must-try-panel');
      const entryContent = document.querySelector('.entry-content');
      if (!panel || !entryContent) return;

      const buttons = panel.querySelectorAll('.must-try-chip');
      if (!buttons.length) return;

      const highlightTargets = Array.from(entryContent.querySelectorAll('p, li')).filter(
        (node) => node.textContent && node.textContent.trim().length > 0
      );
      const highlightClass = 'dish-highlight';
      const activeClass = 'is-active';

      const clearHighlights = () => {
        highlightTargets.forEach((node) => {
          node.classList.remove(highlightClass);
        });
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const dish = button.dataset.dish;
          if (!dish) return;

          const isActive = button.classList.contains(activeClass);
          buttons.forEach((btn) => {
            btn.classList.remove(activeClass);
            btn.setAttribute('aria-pressed', 'false');
          });
          clearHighlights();

          if (isActive) {
            return;
          }

          button.classList.add(activeClass);
          button.setAttribute('aria-pressed', 'true');

          const dishKey = getDishKey(dish);
          const dishTokens = dishKey.split(' ').filter(Boolean);
          let meaningfulTokens = dishTokens.filter((token) => {
            if (stopWords.has(token)) return false;
            if (/\d/.test(token)) return true;
            return token.length > 3;
          });
          if (!meaningfulTokens.length) {
            meaningfulTokens = dishTokens;
          }
          const requiredTokens =
            meaningfulTokens.length <= 1
              ? meaningfulTokens.length
              : Math.min(meaningfulTokens.length, Math.max(2, Math.ceil(meaningfulTokens.length / 2)));
          let firstMatch = null;
          highlightTargets.forEach((node) => {
            const normalizedTarget = normalizeText(node.textContent || '');
            const fullMatch = dishKey && normalizedTarget.includes(dishKey);
            const tokenMatch =
              !fullMatch &&
              meaningfulTokens.length >= requiredTokens &&
              meaningfulTokens.filter((token) => normalizedTarget.includes(token)).length >= requiredTokens;
            if (fullMatch || tokenMatch) {
              node.classList.add(highlightClass);
              if (!firstMatch) {
                firstMatch = node;
              }
            }
          });

          if (!firstMatch) {
            button.classList.remove(activeClass);
            button.setAttribute('aria-pressed', 'false');
            return;
          }

          firstMatch.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMustTryHighlighter);
    } else {
      initMustTryHighlighter();
    }
  </script>
</Base>

<style>
  .must-try-panel {
    margin: 2rem 0;
    padding: 1.25rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: var(--surface-soft);
  }

  .must-try-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .must-try-hint {
    color: var(--muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .must-try-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .must-try-chip {
    appearance: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: white;
    padding: 0.4rem 0.9rem;
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .must-try-chip:hover,
  .must-try-chip:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .must-try-chip.is-active {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
  }

  .restaurant-layout {
    display: flex;
    gap: 2rem;
    max-width: 100ch;
  }

  .jump-nav {
    display: none;
  }

  .jump-nav ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .jump-nav li {
    position: relative;
  }

  .jump-nav a {
    color: var(--muted);
    text-decoration: none;
    display: block;
    padding: 0.25rem 0;
    transition: color 0.2s ease;
    position: relative;
  }

  .jump-nav a span {
    position: relative;
    display: inline-block;
  }

  .jump-nav a span::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  .jump-nav li:hover a,
  .jump-nav li:focus-within a {
    color: var(--accent);
  }

  .jump-nav li:hover a span::after,
  .jump-nav li:focus-within a span::after {
    transform: scaleX(1);
  }

  .restaurant-article {
    flex: 1;
  }

  @media (min-width: 1024px) {
    .jump-nav {
      display: block;
      position: sticky;
      top: 5rem;
      padding-top: 2rem;
      padding-bottom: 1rem;
      align-self: flex-start;
      width: 220px;
    }

    .restaurant-layout {
      max-width: 110ch;
    }
  }

  html {
    scroll-behavior: smooth;
  }

  :global(.dish-highlight) {
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
    padding-left: 0.65rem;
    border-radius: 0.35rem;
    box-shadow: 0 0 0 1px var(--accent-soft);
    transition: background 0.2s ease, border-color 0.2s ease;
  }
</style>
