---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TagPill from '../../components/TagPill.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { resolveHero } from '../../utils/hero';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes', ({ data }) => !data.draft);
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe }
  }));
}

const { recipe } = Astro.props as { recipe: CollectionEntry<'recipes'> };
const formattedDate = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(recipe.data.date);
const timeBlocks = [
  { label: 'Prep', value: recipe.data.prep },
  { label: 'Cook', value: recipe.data.cook },
  { label: 'Total', value: recipe.data.total }
].filter((block) => Boolean(block.value));
const heroSrc = resolveHero(recipe.data.hero);
const recipes = await getCollection('recipes', ({ data }) => !data.draft);
const variantGroup = recipe.data.variantGroup;
const variantList = variantGroup
  ? recipes
      .filter((entry) => entry.data.variantGroup === variantGroup)
      .sort((a, b) => (a.data.complexityLevel ?? 0) - (b.data.complexityLevel ?? 0))
  : [];
const currentIndex = variantGroup
  ? variantList.findIndex((entry) => entry.slug === recipe.slug)
  : -1;
const nextVariant =
  currentIndex !== -1 && currentIndex < variantList.length - 1
    ? variantList[currentIndex + 1]
    : undefined;
const siblings = variantList.filter((entry) => entry.slug !== recipe.slug);
---

<Base title={recipe.data.title} description={`Cook ${recipe.data.title} with Fryday Chef.`}>
  <Header />
  <main class="container" style="max-width:70ch;">
    <a href="/recipes/">← Back to recipes</a>
    <article style="margin-top:1.5rem;">
      <header style="display:flex;flex-direction:column;gap:1rem;position:relative;">
        <p style="margin:0;color:var(--muted);">{formattedDate}</p>
        <div style="display:flex;align-items:flex-start;gap:1rem;">
          <h1 style="margin:0;flex:1;">{recipe.data.title}</h1>
          {variantList.length ? (
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.35rem;">
              <span style="font-size:0.8rem;text-transform:uppercase;color:var(--muted);">
                Complexity
              </span>
              <div style="display:flex;align-items:center;gap:0.75rem;">
                <div style="display:flex;gap:0.4rem;align-items:center;">
                  {variantList.map((entry, index) => {
                    const isActive = entry.slug === recipe.slug;
                    const level = entry.data.complexityLevel ?? index + 1;
                    const style = `width:14px;height:14px;border-radius:50%;display:inline-flex;border:2px solid var(--accent);${
                      isActive ? 'background-color:var(--accent);' : 'background-color:transparent;'
                    }`;
                    return isActive ? (
                      <span
                        style={style}
                        aria-label={`Current complexity level ${level}: ${entry.data.title}`}
                        aria-current="true"
                      />
                    ) : (
                      <a
                        href={`/recipes/${entry.slug}/`}
                        style={style}
                        aria-label={`Go to complexity level ${level}: ${entry.data.title}`}
                      />
                    );
                  })}
                </div>
                {nextVariant ? (
                  <a
                    href={`/recipes/${nextVariant.slug}/`}
                    style="font-size:0.85rem;font-weight:600;color:var(--accent);"
                  >
                    Next →
                  </a>
                ) : (
                  <span style="font-size:0.8rem;color:var(--muted);">Max</span>
                )}
              </div>
            </div>
          ) : null}
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
          {recipe.data.tags.map((tag) => (
            <TagPill tag={tag} />
          ))}
        </div>
        <dl style="display:flex;flex-wrap:wrap;gap:1.5rem;margin:0;">
          <div style="min-width:120px;">
            <dt style="font-weight:600;color:var(--muted);">Servings</dt>
            <dd style="margin:0;font-size:1.25rem;">{recipe.data.servings}</dd>
          </div>
          {timeBlocks.map((block) => (
            <div style="min-width:120px;">
              <dt style="font-weight:600;color:var(--muted);">{block.label}</dt>
              <dd style="margin:0;font-size:1.1rem;">{block.value}</dd>
            </div>
          ))}
        </dl>
      </header>

      {heroSrc ? (
        <img
          src={heroSrc}
          alt={`Hero image for ${recipe.data.title}`}
          style="margin:2rem 0;border-radius:1rem;border:1px solid var(--border);"
          loading="lazy"
          width="800"
          height="450"
        />
      ) : null}

      <section style="display:grid;gap:2rem;">
        <div>
          <h2>Ingredients</h2>
          <ul>
            {recipe.data.ingredients.map((ingredient) => (
              <li>{ingredient}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Steps</h2>
          <ol>
            {recipe.data.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>
      </section>
      <div style="margin-top:2rem;">
        <slot />
      </div>
      {siblings.length ? (
        <section style="margin-top:2.5rem;">
          <h2>More takes</h2>
          <p style="color:var(--muted);margin-top:0.25rem;">
            Choose another version to match your craving.
          </p>
          <div class="card-grid">
            {siblings.map((entry) => (
              <article class="card" style="padding:1rem;">
                <h3 style="margin-top:0;">
                  <a href={`/recipes/${entry.slug}/`}>{entry.data.title}</a>
                </h3>
                <p style="margin:0.25rem 0;color:var(--muted);font-size:0.95rem;">
                  Complexity: {entry.data.complexityLevel ?? '—'}
                </p>
                <a href={`/recipes/${entry.slug}/`} style="font-weight:600;color:var(--accent);">
                  View recipe →
                </a>
              </article>
            ))}
          </div>
        </section>
      ) : null}
    </article>
  </main>
  <Footer />
</Base>
