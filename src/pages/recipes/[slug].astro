---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TagPill from '../../components/TagPill.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes', ({ data }) => !data.draft);
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe }
  }));
}

type StepOption = {
  title?: string;
  description: string;
};

type StructuredStep = {
  text: string;
  detail?: string;
  optionsLabel?: string;
  options?: StepOption[];
};

type RecipeStep = string | StructuredStep;

const isStructuredStep = (step: RecipeStep): step is StructuredStep => typeof step !== 'string';

const { recipe } = Astro.props as { recipe: CollectionEntry<'recipes'> };
const formattedDate = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(recipe.data.date);
const timeBlocks = [
  { label: 'Prep', value: recipe.data.prep },
  { label: 'Cook', value: recipe.data.cook },
  { label: 'Total', value: recipe.data.total }
].filter((block) => Boolean(block.value));
const heroSrc = recipe.data.hero;
const recipes = await getCollection('recipes', ({ data }) => !data.draft);
const variantGroup = recipe.data.variantGroup;
const variantList = variantGroup
  ? recipes
      .filter((entry) => entry.data.variantGroup === variantGroup)
      .sort((a, b) => (a.data.complexityLevel ?? 0) - (b.data.complexityLevel ?? 0))
  : [];
const showVariantSelector = variantList.length > 1;
const formatPreviewText = (entry: CollectionEntry<'recipes'>) =>
  (entry.data.ingredients ?? []).slice(0, 2).join(', ');
const kitchenNoteSlugs = recipe.data.kitchenNotes ?? [];
const allKitchenNotes = kitchenNoteSlugs.length
  ? await getCollection('kitchen-notes')
  : [];
const kitchenNoteMap = new Map(
  allKitchenNotes.map((note) => [note.data.slug ?? note.slug, note])
);
const linkedKitchenNotes = kitchenNoteSlugs
  .map((slug) => kitchenNoteMap.get(slug))
  .filter((note): note is CollectionEntry<'kitchen-notes'> => Boolean(note));
---

<Base title={recipe.data.title} description={`Cook ${recipe.data.title} with Fryday Chef.`}>
  <Header />
  <main class="container" style="max-width:70ch;">
    <a href="/recipes/">← Back to recipes</a>
    <article style="margin-top:1.5rem;">
      <header
        style="display:flex;flex-direction:column;gap:1rem;position:relative;padding:clamp(1.25rem, 3vw, 2rem) clamp(1rem, 4vw, 2.5rem);backdrop-filter:blur(10px);border:1px solid rgba(236,231,223,0.6);border-radius:1.5rem;margin:0 clamp(0.5rem,3vw,1.5rem);"
      >
        <p style="margin:0;color:var(--muted);">{formattedDate}</p>
        <div style="display:flex;align-items:flex-start;gap:1rem;">
          <h1 style="margin:0;flex:1;">{recipe.data.title}</h1>
          {showVariantSelector ? (
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.35rem;">
              <span style="font-size:0.8rem;text-transform:uppercase;color:var(--muted);">
                Complexity
              </span>
              <div style="display:flex;align-items:center;gap:0.75rem;">
                <div style="display:flex;gap:0.4rem;align-items:center;">
                  {variantList.map((entry, index) => {
                    const isActive = entry.slug === recipe.slug;
                    const level = entry.data.complexityLevel ?? index + 1;
                    const baseProps = {
                      class: `complexity-dot${isActive ? ' is-active' : ''}`,
                      'aria-label': `${isActive ? 'Current' : 'Go to'} complexity level ${level}: ${
                        entry.data.title
                      }`
                    };
                    const dot = isActive ? (
                      <span {...baseProps} aria-current="true">
                        {level}
                      </span>
                    ) : (
                      <a {...baseProps} href={`/recipes/${entry.slug}/`}>
                        {level}
                      </a>
                    );
                    return (
                      <div class="complexity-dot-wrapper">
                        {dot}
                        {!isActive ? (
                          <div class="dot-preview">
                            <strong>{entry.data.title}</strong>
                            {entry.data.hero ? (
                              <img
                                src={entry.data.hero}
                                alt={`Preview for ${entry.data.title}`}
                                loading="lazy"
                                width="200"
                                height="120"
                              />
                            ) : (
                              <p>{formatPreviewText(entry) || 'Ingredient notes coming soon.'}</p>
                            )}
                          </div>
                        ) : null}
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          ) : null}
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
          {recipe.data.tags.map((tag) => (
            <TagPill tag={tag} />
          ))}
        </div>
        <dl style="display:flex;flex-wrap:wrap;gap:1.5rem;margin:0;">
          <div style="min-width:120px;">
            <dt style="font-weight:600;color:var(--muted);">Servings</dt>
            <dd style="margin:0;font-size:1.25rem;">{recipe.data.servings}</dd>
          </div>
          {timeBlocks.map((block) => (
            <div style="min-width:120px;">
              <dt style="font-weight:600;color:var(--muted);">{block.label}</dt>
              <dd style="margin:0;font-size:1.1rem;">{block.value}</dd>
            </div>
          ))}
        </dl>
      </header>

      {heroSrc ? (
        <img
          src={heroSrc}
          alt={`Hero image for ${recipe.data.title}`}
          style="margin:2rem 0;border-radius:1rem;border:1px solid var(--border);"
          loading="lazy"
          width="800"
          height="450"
        />
      ) : null}

      <section style="display:grid;gap:2rem;">
        <div>
          <h2>Ingredients</h2>
          <ul>
            {recipe.data.ingredients.map((ingredient) => (
              <li>{ingredient}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Steps</h2>
          <ol class="recipe-steps" data-recipe-key={`recipe-steps:${recipe.slug}`}>
            {recipe.data.steps.map((step, index) => {
              const structured = isStructuredStep(step) ? step : null;
              const primaryText = structured ? structured.text : step;
              return (
                <li class="recipe-step">
                  <div class="step-marker">
                    <input
                      class="step-checkbox"
                      id={`step-${index + 1}`}
                      type="checkbox"
                      data-step-index={index}
                      aria-label={`Mark step ${index + 1} as complete`}
                    />
                    <div class="step-number" aria-hidden="true">
                      <span>{String(index + 1).padStart(2, '0')}</span>
                    </div>
                  </div>
                  <div class="step-content">
                    <p>{primaryText}</p>
                    {structured?.detail ? <p class="step-detail">{structured.detail}</p> : null}
                    {structured?.options?.length ? (
                      <div class="step-options">
                        {structured.optionsLabel ? (
                          <p class="step-options-label">{structured.optionsLabel}</p>
                        ) : null}
                        <div class="step-options-grid">
                          {structured.options.map((option) => (
                            <div class="step-option">
                              {option.title ? <h4>{option.title}</h4> : null}
                              <p>{option.description}</p>
                            </div>
                          ))}
                        </div>
                      </div>
                    ) : null}
                  </div>
                </li>
              );
            })}
          </ol>
        </div>
      </section>
      {linkedKitchenNotes.length ? (
        <section class="kitchen-note-callout">
          <h2>Kitchen Notes for this recipe</h2>
          <div class="note-callout-grid">
            {linkedKitchenNotes.map((note) => (
              <article class="note-callout-card">
                <h3>
                  <a href={`/kitchen-notes/${note.data.slug ?? note.slug}/`}>
                    {note.data.title}
                  </a>
                </h3>
                <p>{note.data.summary}</p>
              </article>
            ))}
          </div>
        </section>
      ) : null}
      <div style="margin-top:2rem;">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Base>
<script>
  const stepList = document.querySelector('.recipe-steps');

  if (stepList) {
    const storageKey = stepList.getAttribute('data-recipe-key') ?? '';

    const stored = (() => {
      try {
        return storageKey ? JSON.parse(localStorage.getItem(storageKey) ?? '[]') : [];
      } catch (error) {
        console.warn('Unable to read saved steps', error);
        return [];
      }
    })();

    const completed = new Set(stored);
    const checkboxes = Array.from(stepList.querySelectorAll<HTMLInputElement>('.step-checkbox'));

    const persist = () => {
      if (!storageKey) return;
      localStorage.setItem(storageKey, JSON.stringify(Array.from(completed)));
    };

    const syncStep = (checkbox: HTMLInputElement) => {
      const stepIndex = Number(checkbox.dataset.stepIndex ?? '');
      const container = checkbox.closest('.recipe-step');

      if (completed.has(stepIndex)) {
        checkbox.checked = true;
        container?.classList.add('is-complete');
      }

      checkbox.addEventListener('change', () => {
        if (checkbox.checked) {
          completed.add(stepIndex);
          container?.classList.add('is-complete');
        } else {
          completed.delete(stepIndex);
          container?.classList.remove('is-complete');
        }

        persist();
      });
    };

    checkboxes.forEach(syncStep);
  }
</script>
