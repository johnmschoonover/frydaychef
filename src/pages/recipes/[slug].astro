---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TagPill from '../../components/TagPill.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes', ({ data }) => !data.draft);
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe }
  }));
}

type StepOption = {
  title?: string;
  description: string;
};

type StructuredStep = {
  text: string;
  detail?: string;
  optionsLabel?: string;
  options?: StepOption[];
  completeLabel?: string;
};

type RecipeStep = string | StructuredStep;

type RecipePhase = {
  title?: string;
  ingredients: string[];
  steps: RecipeStep[];
};

const isStructuredStep = (step: RecipeStep): step is StructuredStep => typeof step !== 'string';

const getPhaseAwareIngredients = (entry: CollectionEntry<'recipes'>) => {
  if (entry.data.ingredients.length) return entry.data.ingredients;
  return entry.data.phases?.flatMap((phase) => phase.ingredients ?? []) ?? [];
};

const { recipe } = Astro.props as { recipe: CollectionEntry<'recipes'> };
const formattedDate = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(recipe.data.date);
const timeBlocks = [
  { label: 'Prep', value: recipe.data.prep },
  { label: 'Cook', value: recipe.data.cook },
  { label: 'Total', value: recipe.data.total }
].filter((block) => Boolean(block.value));
const heroSrc = recipe.data.hero;
const recipes = await getCollection('recipes', ({ data }) => !data.draft);
const variantGroup = recipe.data.variantGroup;
const variantList = variantGroup
  ? recipes
      .filter((entry) => entry.data.variantGroup === variantGroup)
      .sort((a, b) => (a.data.complexityLevel ?? 0) - (b.data.complexityLevel ?? 0))
  : [];
const showVariantSelector = variantList.length > 1;
const formatPreviewText = (entry: CollectionEntry<'recipes'>) =>
  getPhaseAwareIngredients(entry).slice(0, 2).join(', ');
const kitchenNoteSlugs = recipe.data.kitchenNotes ?? [];
const allKitchenNotes = kitchenNoteSlugs.length
  ? await getCollection('kitchen-notes')
  : [];
const kitchenNoteMap = new Map(
  allKitchenNotes.map((note) => [note.data.slug ?? note.slug, note])
);
const linkedKitchenNotes = kitchenNoteSlugs
  .map((slug) => kitchenNoteMap.get(slug))
  .filter((note): note is CollectionEntry<'kitchen-notes'> => Boolean(note));
const phases: RecipePhase[] = recipe.data.phases ?? [];
const hasPhases = phases.length > 0;
const normalizedPhases: RecipePhase[] = (hasPhases
  ? phases
  : [{ title: undefined, ingredients: recipe.data.ingredients, steps: recipe.data.steps }]
).map((phase) => ({
  title: phase.title,
  ingredients: phase.ingredients ?? [],
  steps: phase.steps ?? []
}));
---

<Base title={recipe.data.title} description={`Cook ${recipe.data.title} with Fryday Chef.`}>
  <Header />
  <main class="container recipe-layout">
    <a href="/recipes/">← Back to recipes</a>
    <article style="margin-top:1.5rem;">
      <header
        style="display:flex;flex-direction:column;gap:1rem;position:relative;padding:clamp(1.25rem, 3vw, 2rem) clamp(1rem, 4vw, 2.5rem);backdrop-filter:blur(10px);border:1px solid rgba(236,231,223,0.6);border-radius:1.5rem;margin:0 clamp(0.5rem,3vw,1.5rem);"
      >
        <p style="margin:0;color:var(--muted);">{formattedDate}</p>
        <div style="display:flex;align-items:flex-start;gap:1rem;">
          <h1 style="margin:0;flex:1;">{recipe.data.title}</h1>
          {showVariantSelector ? (
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.35rem;">
              <span style="font-size:0.8rem;text-transform:uppercase;color:var(--muted);">
                Complexity
              </span>
              <div style="display:flex;align-items:center;gap:0.75rem;">
                <div style="display:flex;gap:0.4rem;align-items:center;">
                  {variantList.map((entry, index) => {
                    const isActive = entry.slug === recipe.slug;
                    const level = entry.data.complexityLevel ?? index + 1;
                    const baseProps = {
                      class: `complexity-dot${isActive ? ' is-active' : ''}`,
                      'aria-label': `${isActive ? 'Current' : 'Go to'} complexity level ${level}: ${
                        entry.data.title
                      }`
                    };
                    const dot = isActive ? (
                      <span {...baseProps} aria-current="true">
                        {level}
                      </span>
                    ) : (
                      <a {...baseProps} href={`/recipes/${entry.slug}/`}>
                        {level}
                      </a>
                    );
                    return (
                      <div class="complexity-dot-wrapper">
                        {dot}
                        {!isActive ? (
                          <div class="dot-preview">
                            <strong>{entry.data.title}</strong>
                            {entry.data.hero ? (
                              <img
                                src={entry.data.hero}
                                alt={`Preview for ${entry.data.title}`}
                                loading="lazy"
                                width="200"
                                height="120"
                              />
                            ) : (
                              <p>{formatPreviewText(entry) || 'Ingredient notes coming soon.'}</p>
                            )}
                          </div>
                        ) : null}
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          ) : null}
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
          {recipe.data.tags.map((tag) => (
            <TagPill tag={tag} />
          ))}
        </div>
        <dl style="display:flex;flex-wrap:wrap;gap:1.5rem;margin:0;">
          <div style="min-width:120px;">
            <dt style="font-weight:600;color:var(--muted);">Servings</dt>
            <dd style="margin:0;font-size:1.25rem;">{recipe.data.servings}</dd>
          </div>
          {timeBlocks.map((block) => (
            <div style="min-width:120px;">
              <dt style="font-weight:600;color:var(--muted);">{block.label}</dt>
              <dd style="margin:0;font-size:1.1rem;">{block.value}</dd>
            </div>
          ))}
        </dl>
      </header>

      {heroSrc ? (
        <img
          src={heroSrc}
          alt={`Hero image for ${recipe.data.title}`}
          style="margin:2rem 0;border-radius:1rem;border:1px solid var(--border);"
          loading="lazy"
          width="800"
          height="450"
        />
      ) : null}

      <section class="recipe-phase-stack">
        <h2 class="recipe-phase-stack__title">Ingredients &amp; Steps</h2>
        <div class="recipe-phase-stack__inner">
          {normalizedPhases.map((phase, phaseIndex) => {
            const phaseKey = hasPhases ? `phase-${phaseIndex + 1}` : 'base';
            const ingredientKey = `recipe-ingredients:${recipe.slug}:${phaseKey}`;
            const stepKey = `recipe-steps:${recipe.slug}:${phaseKey}`;
            return (
              <article class="recipe-phase">
                {phase.title ? <p class="recipe-phase__label">{phase.title}</p> : null}
                <div class="recipe-phase__columns">
                  {phase.ingredients.length ? (
                    <div>
                      <h3>Ingredients</h3>
                      <ul class="recipe-ingredients" data-recipe-key={ingredientKey}>
                        {phase.ingredients.map((ingredient, index) => (
                          <li class="recipe-ingredient">
                            <input
                              class="ingredient-checkbox"
                              id={`ingredient-${phaseKey}-${index + 1}`}
                              type="checkbox"
                              data-ingredient-index={index}
                              aria-label={`Mark ingredient ${index + 1}${phase.title ? ` for ${phase.title}` : ''} as gathered`}
                            />
                            <span class="ingredient-text">{ingredient}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ) : null}
                  {phase.steps.length ? (
                    <div>
                      <h3>Steps</h3>
                      <ol class="recipe-steps" data-recipe-key={stepKey}>
                        {phase.steps.map((step, index) => {
                          const structured = isStructuredStep(step) ? step : null;
                          const primaryText = structured ? structured.text : step;
                          return (
                            <li class="recipe-step">
                              <div class="step-marker">
                                <input
                                  class="step-checkbox"
                                  id={`step-${phaseKey}-${index + 1}`}
                                  type="checkbox"
                                  data-step-index={index}
                                  aria-label={`Mark step ${index + 1}${phase.title ? ` in ${phase.title}` : ''} as complete`}
                                />
                                <div class="step-number" aria-hidden="true">
                                  <span>{String(index + 1).padStart(2, '0')}</span>
                                </div>
                                <span class="step-complete-label">
                                  {structured?.completeLabel ?? 'Done'}
                                </span>
                              </div>
                              <div class="step-content">
                                <p>{primaryText}</p>
                                {structured?.detail ? <p class="step-detail">{structured.detail}</p> : null}
                                {structured?.options?.length ? (
                                  <div class="step-options">
                                    {structured.optionsLabel ? (
                                      <p class="step-options-label">{structured.optionsLabel}</p>
                                    ) : null}
                                    <div class="step-options-grid">
                                      {structured.options.map((option) => (
                                        <div class="step-option">
                                          {option.title ? <h4>{option.title}</h4> : null}
                                          <p>{option.description}</p>
                                        </div>
                                      ))}
                                    </div>
                                  </div>
                                ) : null}
                              </div>
                            </li>
                          );
                        })}
                      </ol>
                    </div>
                  ) : null}
                </div>
              </article>
            );
          })}
        </div>
      </section>
      {linkedKitchenNotes.length ? (
        <section class="kitchen-note-callout">
          <h2>Kitchen Notes for this recipe</h2>
          <div class="note-callout-grid">
            {linkedKitchenNotes.map((note) => (
              <article class="note-callout-card">
                <h3>
                  <a href={`/kitchen-notes/${note.data.slug ?? note.slug}/`}>
                    {note.data.title}
                  </a>
                </h3>
                <p>{note.data.summary}</p>
              </article>
            ))}
          </div>
        </section>
      ) : null}
      <div style="margin-top:2rem;">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Base>
<script>
  const readStoredIndexes = (storageKey: string) => {
    if (!storageKey) return [];
    try {
      const parsed = JSON.parse(localStorage.getItem(storageKey) ?? '[]');
      return Array.isArray(parsed)
        ? parsed
            .map((value) => Number(value))
            .filter((value) => Number.isFinite(value))
        : [];
    } catch (error) {
      console.warn('Unable to read saved checklist', error);
      return [];
    }
  };

  const stepLists = Array.from(document.querySelectorAll<HTMLOListElement>('.recipe-steps'));

  stepLists.forEach((stepList) => {
    const storageKey = stepList.getAttribute('data-recipe-key') ?? '';
    const completed = new Set<number>(readStoredIndexes(storageKey));
    const checkboxes = Array.from(stepList.querySelectorAll<HTMLInputElement>('.step-checkbox'));

    const persist = () => {
      if (!storageKey) return;
      localStorage.setItem(storageKey, JSON.stringify(Array.from(completed)));
    };

    const syncStep = (checkbox: HTMLInputElement) => {
      const stepIndex = Number(checkbox.dataset.stepIndex ?? '');
      const container = checkbox.closest('.recipe-step');

      if (completed.has(stepIndex)) {
        checkbox.checked = true;
        container?.classList.add('is-complete');
      }

      checkbox.addEventListener('change', () => {
        if (checkbox.checked) {
          completed.add(stepIndex);
          container?.classList.add('is-complete');
        } else {
          completed.delete(stepIndex);
          container?.classList.remove('is-complete');
        }

        persist();
      });

      container?.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        if (!target || target.closest('a') || target.closest('.step-checkbox')) return;

        checkbox.checked = !checkbox.checked;
        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
      });
    };

    checkboxes.forEach(syncStep);
  });

  const ingredientLists = Array.from(
    document.querySelectorAll<HTMLUListElement>('.recipe-ingredients')
  );

  ingredientLists.forEach((ingredientList) => {
    const storageKey = ingredientList.getAttribute('data-recipe-key') ?? '';
    const gathered = new Set<number>(readStoredIndexes(storageKey));
    const checkboxes = Array.from(
      ingredientList.querySelectorAll<HTMLInputElement>('.ingredient-checkbox')
    );

    const persist = () => {
      if (!storageKey) return;
      localStorage.setItem(storageKey, JSON.stringify(Array.from(gathered)));
    };

    const syncIngredient = (checkbox: HTMLInputElement) => {
      const index = Number(checkbox.dataset.ingredientIndex ?? '');
      const container = checkbox.closest('.recipe-ingredient');

      if (gathered.has(index)) {
        checkbox.checked = true;
        container?.classList.add('is-complete');
      }

      checkbox.addEventListener('change', () => {
        if (checkbox.checked) {
          gathered.add(index);
          container?.classList.add('is-complete');
        } else {
          gathered.delete(index);
          container?.classList.remove('is-complete');
        }

        persist();
      });

      container?.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        if (!target || target.closest('a') || target.closest('.ingredient-checkbox')) return;

        checkbox.checked = !checkbox.checked;
        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
      });
    };

    checkboxes.forEach(syncIngredient);
  });
</script>
