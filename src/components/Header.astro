---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/recipes/', label: 'Recipes' },
  { href: '/restaurants/', label: 'Restaurants' },
  { href: '/travel/', label: 'Travel' },
  { href: '/about/', label: 'About' }
];

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-brand">
      <span class="site-brand__title">Fryday Chef</span>
      <span class="site-brand__subtitle">Kitchen & Travel</span>
    </a>
    <nav aria-label="Primary">
      <ul class="site-nav">
        {navItems.map((item) => {
          const normalized = item.href.endsWith('/') ? item.href : `${item.href}/`;
          const isCurrent =
            normalized === '/'
              ? pathname === '/'
              : pathname.startsWith(normalized);
          return (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent ? 'page' : undefined}
                class={`site-nav__link${isCurrent ? ' is-active' : ''}`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
