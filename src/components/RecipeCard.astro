---
import type { CollectionEntry } from 'astro:content';
import TagPill from './TagPill.astro';

const { recipe } = Astro.props as { recipe: CollectionEntry<'recipes'> };
const formattedDate = new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(
  recipe.data.date
);
const heroSrc = recipe.data.hero;
const detailUrl = `/recipes/${recipe.slug}/`;
---

<article class="card card-link" style="display:flex;flex-direction:column;gap:1rem;">
  <a class="card-link__hit" href={detailUrl} aria-label={`View recipe: ${recipe.data.title}`}></a>
  {heroSrc ? (
    <img
      src={heroSrc}
      alt={`Hero image for ${recipe.data.title}`}
      style="border-radius:0.75rem;border:1px solid var(--border);background:var(--bg);"
      loading="lazy"
      width="640"
      height="360"
    />
  ) : null}
  <div style="display:flex;flex-direction:column;gap:0.5rem;">
    <h3 style="margin:0 0 0.25rem 0;">{recipe.data.title}</h3>
    <p style="margin:0;color:var(--muted);font-size:0.95rem;">{formattedDate}</p>
    <div style="display:flex;flex-wrap:wrap;gap:0.35rem;">
      {recipe.data.tags.map((tag) => (
        <TagPill tag={tag} />
      ))}
    </div>
  </div>
</article>
