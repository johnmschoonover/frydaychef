{
  "name": "frydaychef",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.14.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "sync": "astro sync",
    "build": "astro build",
    "preview": "astro preview",
    "format:md": "prettier --cache --write \"**/*.md\"",
    "lint:md": "markdownlint \"**/*.md\"",
    "check:heroes": "node scripts/check-heroes.mjs",
    "check:progress-ttl": "node scripts/check-progress-ttl.mjs",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/markdoc": "^0.15.10",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.14",
    "@keystatic/astro": "^5.0.6",
    "@keystatic/core": "^0.5.48",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.16.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "lint-staged": "^16.2.7",
    "markdownlint-cli": "^0.47.0",
    "prettier": "^3.7.4",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "ts-standard": "^12.0.2",
    "typescript": "^5.9.3",
    "zod": "^4.3.5"
  },
  "overrides": {
    "glob": "11.1.0"
  },
  "lint-staged": {
    "**/*.{md,mdx}": [
      "prettier --write",
      "markdownlint --config .markdownlint.json"
    ],
    "src/content/recipes/**/*.{md,mdx}": [
      "node scripts/validate-content.mjs recipes"
    ],
    "src/content/restaurants/**/*.{md,mdx}": [
      "node scripts/validate-content.mjs restaurants"
    ],
    "src/content/travel/**/*.{md,mdx}": [
      "node scripts/validate-content.mjs travel"
    ],
    "src/content/kitchen-notes/**/*.{md,mdx}": [
      "node scripts/validate-content.mjs kitchen-notes"
    ]
  }
}
