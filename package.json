{
  "name": "frydaychef",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "sync": "astro sync",
    "build": "astro build",
    "preview": "astro preview",
    "format:md": "prettier --cache --write \"**/*.md\"",
    "lint:md": "markdownlint \"**/*.md\"",
    "check:heroes": "node scripts/check-heroes.mjs",
    "check:progress-ttl": "node scripts/check-progress-ttl.mjs",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/markdoc": "^0.15.11",
    "@astrojs/react": "^6.0.0",
    "@astrojs/rss": "^4.0.19",
    "@keystatic/astro": "^5.1.0",
    "@keystatic/core": "^0.5.50",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.18.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "lint-staged": "^17.0.8",
    "markdownlint-cli": "^0.49.0",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-standard": "^12.0.2",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "**/*.{md,mdx}": [
      "prettier --write",
      "markdownlint --config .markdownlint.json"
    ],
    "src/content/recipes/**/*.{md,mdx}": [
      "node scripts/validate-content.mjs recipes"
    ],
    "src/content/restaurants/**/*.{md,mdx}": [
      "node scripts/validate-content.mjs restaurants"
    ],
    "src/content/travel/**/*.{md,mdx}": [
      "node scripts/validate-content.mjs travel"
    ],
    "src/content/kitchen-notes/**/*.{md,mdx}": [
      "node scripts/validate-content.mjs kitchen-notes"
    ]
  }
}
